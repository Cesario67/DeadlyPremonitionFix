<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:DPStabilityFix.Launcher.ViewModels"
        x:Class="DPStabilityFix.Launcher.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding L[WindowTitle]}"
        Width="860" Height="700" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterScreen">

  <DockPanel Margin="16">

    <!-- Dossier du jeu -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,0,0,12">
      <TextBlock Grid.Column="0" Text="{Binding L[GameFolder]}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding GameDirectory}" IsReadOnly="True" />
      <Button Grid.Column="2" Content="{Binding L[Change]}" Margin="8,0,0,0" Click="ChooseGameFolder" />
      <ComboBox Grid.Column="3" Margin="16,0,0,0" MinWidth="120" ItemsSource="{Binding Languages}"
                SelectedItem="{Binding SelectedLanguage}" />
    </Grid>

    <!-- Barre du bas : message, enregistrer, jouer -->
    <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,12,0,0">
      <TextBlock Grid.Column="0" Text="{Binding Message}" TextWrapping="Wrap" VerticalAlignment="Center" />
      <Button Grid.Column="1" Content="{Binding L[ResetDefaults]}" Command="{Binding ResetSettingsCommand}" Margin="8,0,0,0" />
      <Button Grid.Column="2" Content="{Binding L[Save]}" Command="{Binding SaveSettingsCommand}" Margin="8,0" />
      <Button Grid.Column="3" Content="{Binding L[Play]}" Command="{Binding PlayCommand}" Classes="accent"
              FontWeight="SemiBold" Padding="24,8" />
    </Grid>

    <TabControl IsEnabled="{Binding HasGame}">

      <!-- Graphismes -->
      <TabItem Header="{Binding L[TabGraphics]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Graphics}" x:DataType="vm:GraphicsViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecDisplay]}" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Text="{Binding L[Mode]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DisplayModes}" SelectedItem="{Binding SelectedDisplayMode}" />
              <TextBlock Grid.Row="1" Text="{Binding L[Resolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding Resolutions}" SelectedItem="{Binding SelectedResolution}" />
            </Grid>

            <TextBlock Classes="section" Text="{Binding L[SecAntiAliasing]}" />
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding AntiAliasingLevels}" SelectedItem="{Binding SelectedAntiAliasing}" />
            <TextBlock Classes="hint" Text="{Binding RenderResolutionText}" />
            <TextBlock Classes="hint"
                       Text="{Binding L[AntiAliasingHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecEffects]}" />
            <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Grid.Row="0" Text="{Binding L[AmbientOcclusion]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding AmbientOcclusionLevels}" SelectedItem="{Binding SelectedAmbientOcclusion}" />
              <TextBlock Grid.Row="1" Text="{Binding L[ShadowResolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DetailScales}" SelectedItem="{Binding SelectedShadows}" />
              <TextBlock Grid.Row="2" Text="{Binding L[ReflectionResolution]}" VerticalAlignment="Center" />
              <ComboBox Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch"
                        ItemsSource="{Binding DetailScales}" SelectedItem="{Binding SelectedReflections}" />
            </Grid>
            <CheckBox Content="{Binding L[PreciseShadows]}" IsChecked="{Binding PreciseShadows}" />
            <CheckBox Content="{Binding L[ImprovedDof]}" IsChecked="{Binding ImprovedDepthOfField}" />
            <CheckBox Content="{Binding L[Anisotropic]}" IsChecked="{Binding AnisotropicFiltering}" />
            <TextBlock Classes="hint" Text="{Binding L[DpfixCredit]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Stabilité -->
      <TabItem Header="{Binding L[TabStability]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Stability}" x:DataType="vm:StabilityViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecSaves]}" />
            <CheckBox Content="{Binding L[AtomicSave]}" IsChecked="{Binding AtomicSaveWrites}" />
            <TextBlock Classes="hint" Text="{Binding L[AtomicSaveHint]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding L[BackupCount]}" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding SaveBackupCount}" Minimum="1" Maximum="500" Increment="5" Width="140" FormatString="0" />
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding L[SecController]}" />
            <CheckBox Content="{Binding L[SonyLayout]}" IsChecked="{Binding SonyControllerLayout}" />
            <TextBlock Classes="hint" Text="{Binding L[SonyLayoutHint]}" />
            <CheckBox Content="{Binding L[SwapTriggers]}" IsChecked="{Binding SwapControllerTriggers}" />
            <CheckBox Content="{Binding L[BackgroundPolling]}" IsChecked="{Binding BackgroundControllerPolling}" />
            <TextBlock Classes="hint" Text="{Binding L[BackgroundPollingHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecGame]}" />
            <CheckBox Content="{Binding L[AimFix]}" IsChecked="{Binding AimPrecisionGuard}" />
            <TextBlock Classes="hint" Text="{Binding L[AimFixHint]}" />

            <TextBlock Classes="section" Text="{Binding L[SecSmoothness]}" />
            <CheckBox Content="{Binding L[PreciseGameTime]}" IsChecked="{Binding PreciseGameTime}" />
            <TextBlock Classes="hint" Text="{Binding L[PreciseGameTimeHint]}" />
            <CheckBox Content="{Binding L[PreciseTimer]}" IsChecked="{Binding PreciseTimer}" />
            <TextBlock Classes="hint" Text="{Binding L[PreciseTimerHint]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <TextBlock Text="{Binding L[FrameLimit]}" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding FrameLimitFps}" Minimum="0" Maximum="1000" Increment="30" Width="140" FormatString="0" />
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding L[SecDiagnostics]}" />
            <CheckBox Content="{Binding L[CrashDumps]}" IsChecked="{Binding CrashDumps}" />
            <CheckBox Content="{Binding L[FullDumps]}" IsChecked="{Binding FullMemoryDumps}" />
            <CheckBox Content="{Binding L[FrameStats]}" IsChecked="{Binding FrameStats}" />

            <TextBlock Classes="section" Text="{Binding L[SecGraphicsMod]}" />
            <CheckBox Content="{Binding L[IntegratedDpfix]}" IsChecked="{Binding IntegratedDpfix}" />
            <TextBlock Classes="hint" Text="{Binding L[IntegratedDpfixHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- Sauvegardes -->
      <TabItem Header="{Binding L[TabSaves]}">
        <DockPanel Margin="0,8" DataContext="{Binding Saves}" x:DataType="vm:SavesViewModel">
          <TextBlock DockPanel.Dock="Top" Text="{Binding CurrentSave}" Margin="0,0,0,8" />
          <Button DockPanel.Dock="Bottom" Content="{Binding L[RestoreSelected]}" Margin="0,8,0,0"
                  Command="{Binding RestoreCommand}" />
          <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:SaveBackupItem">
                <Grid ColumnDefinitions="180,*,90">
                  <TextBlock Grid.Column="0" Text="{Binding Date}" />
                  <TextBlock Grid.Column="1" Text="{Binding Description}" />
                  <TextBlock Grid.Column="2" Text="{Binding Size}" HorizontalAlignment="Right" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </TabItem>

      <!-- Installation -->
      <TabItem Header="{Binding L[TabInstall]}">
        <ScrollViewer>
          <StackPanel Spacing="6" Margin="0,8" DataContext="{Binding Status}" x:DataType="vm:StatusViewModel">
            <TextBlock Classes="section" Text="{Binding L[SecStatus]}" />
            <TextBlock Text="{Binding GameVersion}" />
            <TextBlock Text="{Binding ModState}" />
            <TextBlock Text="{Binding MemoryState}" />
            <TextBlock Text="{Binding DpfixState}" TextWrapping="Wrap" />

            <TextBlock Classes="section" Text="{Binding L[SecInstallation]}" />
            <Button Content="{Binding InstallButtonText}" Command="{Binding InstallCommand}" />
            <TextBlock Classes="hint" Text="{Binding L[InstallHint]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[DisableExternalDpfix]}" Command="{Binding DisableExternalDpfixCommand}" />
              <Button Content="{Binding L[RestoreExternalDpfix]}" Command="{Binding RestoreExternalDpfixCommand}" />
              <Button Content="{Binding L[Uninstall]}" Command="{Binding UninstallCommand}" />
            </StackPanel>

            <TextBlock Classes="section" Text="{Binding L[SecSteam]}" />
            <TextBlock Classes="hint" Text="{Binding L[SteamHint]}" />
            <Grid ColumnDefinitions="*,Auto">
              <TextBox Grid.Column="0" Text="{Binding SteamLaunchOption}" IsReadOnly="True" />
              <Button Grid.Column="1" Content="{Binding L[Copy]}" Margin="8,0,0,0" Click="CopySteamLaunchOption" />
            </Grid>

            <TextBlock Classes="section" Text="{Binding L[SecDiagnosticTools]}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{Binding L[OpenLatestLog]}" Command="{Binding OpenLatestLogCommand}" />
              <Button Content="{Binding L[OpenModFolder]}" Command="{Binding OpenModFolderCommand}" />
            </StackPanel>
            <TextBlock Classes="hint" Text="{Binding L[CrashReportHint]}" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>

    </TabControl>
  </DockPanel>
</Window>
